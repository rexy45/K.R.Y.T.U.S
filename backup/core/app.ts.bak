import { KYRÖSYS } from "../autonomous/kyrosys";
import { speak } from "../voice/piper";
import { voiceManager } from "../voice/VoiceManager";
import { LOOP } from "./loop";

import { handleCommand } from "../commands/commands";
import { handleMemoryCommand } from "../commands/memory";
import { handleExit } from "../commands/exit";

import { SETTINGS } from "../config/settings";
import { showThinking, showReply, showError } from "../ui/output";
import { input } from "@inquirer/prompts";
import { KrytusEngine } from "./engine";

const kyrosys = new KYROSYS({
  name: "Rexy",
  tone: "mixed",
  humor: "medium",
});

const engine = new KrytusEngine();

/*
==========================================================
Main CLI
==========================================================
*/

export async function startCLI() {
  const memory = engine.getMemoryManager();
  const identity = memory.loadCore();
  
  await kyrosys.runOnce(speak);

  while (true) {
      //------------------------------------------------
      // USER INPUT
      //------------------------------------------------

      const command = await input({
          message: "KRYTUS >",
      });

      //------------------------------------------------
      // VOICE MODE
      //------------------------------------------------

      if (command.trim().toLowerCase() === "/voice") {
          console.log("Say 'exit voice mode' to leave.\n");

          await voiceManager.start(async (spokenText) => {
              const lower = spokenText.trim().toLowerCase();

              if (
                  lower === "exit voice mode" ||
                  lower === "voice off" ||
                  lower === "stop listening"
              ) {
                  console.log("\n👋 Leaving Voice Mode...\n");
                  await voiceManager.stop();
                  return;
              }

              console.log(`\nYou: ${spokenText}\n`);

              await engine.processPrompt(spokenText, identity, {
                  onThinking: () => {
                      if (SETTINGS.thinking) showThinking();
                  },
                  onReply: (name, reply) => showReply(name, reply),
                  onError: (err) => showError(err),
                  onSpeak: async (text) => await speak(text),
                  onLog: (msg) => {
                      if (SETTINGS.debug) console.log(msg);
                  }
              });
          });
          continue;
      }

      //------------------------------------------------
      // LOOP COMMANDS
      //------------------------------------------------

      if (command === "/loop on") {
          LOOP.enabled = true;
          console.log("\n✓ Autonomous Loop Enabled\n");
          continue;
      }

      if (command === "/loop off") {
          LOOP.enabled = false;
          console.log("\n✓ Autonomous Loop Disabled\n");
          continue;
      }

      //------------------------------------------------
      // BUILT-IN COMMANDS
      //------------------------------------------------

      if (handleCommand(command)) continue;
      if (handleExit(command)) continue;
      if (handleMemoryCommand(command)) continue;

      //------------------------------------------------
      // NORMAL KEYBOARD CHAT
      //------------------------------------------------

      await engine.processPrompt(command, identity, {
          onThinking: () => {
              if (SETTINGS.thinking) showThinking();
          },
          onReply: (name, reply) => showReply(name, reply),
          onError: (err) => showError(err),
          onSpeak: async (text) => await speak(text),
          onLog: (msg) => {
              if (SETTINGS.debug) console.log(msg);
          }
      });
  }
}
